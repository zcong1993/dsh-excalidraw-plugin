{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "ignorePatterns": [
    "lib/**",
    "node_modules/**",
    ".worktrees/**",
    ".tmp/**",
    "coverage/**"
  ]
}
