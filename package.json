{
  "name": "@zcong/dsh-excalidraw-plugin",
  "version": "0.3.9",
  "description": "Excalidraw canvas for DeepSeek Harness: natural-language diagrams, sidebar editing, PNG/SVG export.",
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "happy-dom": "21.0.4",
    "oxlint": "1.90.0",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "bun test",
    "build:canvas": "bun build-library.ts",
    "build:host": "bun build-host.ts",
    "build": "bun build:canvas && bun build:host",
    "prepublishOnly": "bun run build",
    "lint": "oxlint src tests build-host.ts build-library.ts scripts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:coverage": "bun test --coverage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "packageManager": "pnpm@11.28.5",
  "keywords": [
    "excalidraw",
    "deepseek-harness",
    "dsh",
    "cordis",
    "diagram",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcong1993/dsh-excalidraw-plugin.git"
  },
  "homepage": "https://github.com/zcong1993/dsh-excalidraw-plugin#readme",
  "bugs": {
    "url": "https://github.com/zcong1993/dsh-excalidraw-plugin/issues"
  }
}
